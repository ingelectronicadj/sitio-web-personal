<%- include('partials/head-post', { post: post }) %>
  <body id="page-top">
<%- include('partials/sidebar', { rootPrefix: '../' }) %>

    <main>
      <section class="resume-section p-3 p-lg-5 d-flex flex-column">
        <div class="my-auto">
          <article>
            <a href="../index.html#blog" class="back-btn" data-i18n="blog-back-btn">
              <i class="fas fa-arrow-left" aria-hidden="true"></i> Volver al Portafolio
            </a>

            <!-- Header del artículo -->
            <header class="blog-post-header d-flex flex-column flex-md-row align-items-center mb-5">
              <div class="mr-md-4 flex-grow-1">
                <h1 class="blog-title mb-3" data-i18n="<%= post.i18nPrefix %>-title"><%- post.titleHtml %></h1>
                <div class="subheading mb-4" data-i18n="<%= post.i18nPrefix %>-date"><%= post.dateLabel %></div>
                <p class="lead" data-i18n="<%= post.i18nPrefix %>-desc"><%= post.excerpt %></p>
              </div>
              <div class="flex-shrink-0 mt-4 mt-md-0 text-center text-md-right">
                <img src="../<%= post.image %>" alt="" class="img-fluid rounded shadow-sm blog-main-img" aria-hidden="true" style="max-width: 250px;" />
              </div>
            </header>

            <!-- Contenido principal -->
            <div class="blog-content mb-5">
<%- post.bodyHtml %>
            </div>
          </article>
        </div>
      </section>
    </main>

<%- include('partials/scripts-post', { post: post }) %>
