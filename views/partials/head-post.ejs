<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta
      name="description"
      content="<%= post.metaDescription %>"
    />
    <meta name="author" content="Diego Javier Mena Amado" />
    <% if (post.keywords) { %>
    <meta name="keywords" content="<%= post.keywords %>" />
    <% } %>
    <script>
      (function () {
        try {
          if (localStorage.getItem("status_contrast") === "true") {
            document.documentElement.classList.add("dark");
          }
          var l = localStorage.getItem("preferred_lang");
          if (l && l !== "es") {
            document.documentElement.lang = l;
            document.documentElement.classList.add("i18n-pending");
            setTimeout(function () {
              document.documentElement.classList.remove("i18n-pending");
            }, 2000);
          }
        } catch (e) {}
      })();
    </script>

    <title data-i18n="<%= post.i18nPrefix %>-page-title">
      <%= post.pageTitle %>
    </title>

    <link rel="icon" type="image/webp" href="../img/favicon-diego.webp" />
    <link rel="alternate" hreflang="es" href="https://diegomena.rocks/blog/<%= post.slug %>.html" />
    <link rel="alternate" hreflang="en" href="https://diegomena.rocks/blog/<%= post.slug %>.html" />
    <link rel="alternate" hreflang="x-default" href="https://diegomena.rocks/blog/<%= post.slug %>.html" />
    <link rel="alternate" type="text/markdown" href="https://diegomena.rocks/llms-full.txt" title="Diego Mena — Full LLM Technical Context" />

    <!-- Tipografia -->
    <link
      href="https://fonts.googleapis.com/css?family=Saira+Extra+Condensed:500,700"
      rel="stylesheet"
      type="text/css" />
    <link
      href="https://fonts.googleapis.com/css?family=Muli:400,400i,800,800i"
      rel="stylesheet"
      type="text/css" />
    <link href="../vendor/fontawesome-free/css/all.min.css" rel="stylesheet" />

    <!-- Bundle unificado de estilos (bootstrap + resume + darkMode + blog + slick) -->
    <link rel="stylesheet" href="../css/bundle.min.css?v=<%= version %>" />

    <!-- Canonical + Open Graph + Twitter Card (articulo) -->
    <link rel="canonical" href="https://diegomena.rocks/blog/<%= post.slug %>.html" />
    <meta property="og:url" content="https://diegomena.rocks/blog/<%= post.slug %>.html" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="<%= post.ogTitle %>" />
    <meta property="og:description" content="<%= post.metaDescription %>" />
    <meta property="og:image" content="https://diegomena.rocks/<%= post.image %>" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="<%= post.imageAlt || post.ogTitle %>" />
    <meta property="article:published_time" content="<%= post.datePublished %>" />
    <meta property="article:modified_time" content="<%= post.dateModified %>" />
    <meta property="article:author" content="https://diegomena.rocks/#person" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:site_name" content="Diego Mena — Experto en Accesibilidad Digital" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= post.ogTitle %>" />
    <meta name="twitter:description" content="<%= post.metaDescription %>" />
    <meta name="twitter:image" content="https://diegomena.rocks/<%= post.image %>" />
    <meta name="twitter:image:alt" content="<%= post.imageAlt || post.ogTitle %>" />

    <!-- Datos estructurados JSON-LD (BlogPosting + Person E-E-A-T + BreadcrumbList) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "BlogPosting",
            "@id": "https://diegomena.rocks/blog/<%= post.slug %>.html#post",
            "mainEntityOfPage": "https://diegomena.rocks/blog/<%= post.slug %>.html",
            "headline": "<%- post.ogTitle.replace(/"/g, '\\"') %>",
            "description": "<%- post.metaDescription.replace(/"/g, '\\"') %>",
            "url": "https://diegomena.rocks/blog/<%= post.slug %>.html",
            "image": {
              "@type": "ImageObject",
              "url": "https://diegomena.rocks/<%= post.image %>",
              "width": 1200,
              "height": 630,
              "caption": "<%- (post.imageAlt || post.ogTitle).replace(/"/g, '\\"') %>"
            },
            "inLanguage": ["es", "en"],
            "datePublished": "<%= post.datePublished %>",
            "dateModified": "<%= post.dateModified %>",
            "keywords": "<%- (post.keywords || 'accesibilidad web, WCAG 2.2, Diego Mena').replace(/"/g, '\\"') %>",
            "isPartOf": { "@id": "https://diegomena.rocks/#website" },
            "author": { "@id": "https://diegomena.rocks/#person" },
            "publisher": { "@id": "https://diegomena.rocks/#person" }
          },
          {
            "@type": "Person",
            "@id": "https://diegomena.rocks/#person",
            "name": "Diego Javier Mena Amado",
            "jobTitle": "Experto en Accesibilidad Digital (WCAG 2.2 · EN 301 549 · Shift Left)",
            "url": "https://diegomena.rocks/",
            "image": "https://diegomena.rocks/img/profile-pic.webp",
            "sameAs": [
              "https://www.linkedin.com/in/ingelectronicadj/",
              "https://github.com/ingelectronicadj",
              "https://gitlab.com/ingelectronicadj",
              "https://scholar.google.com/citations?user=sn7a5boAAAAJ&hl=es",
              "https://orcid.org/0000-0002-8587-9346",
              "https://a11ypro.tech"
            ]
          },
          {
            "@type": "BreadcrumbList",
            "@id": "https://diegomena.rocks/blog/<%= post.slug %>.html#breadcrumb",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Diego Mena — Portafolio",
                "item": "https://diegomena.rocks/"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": "Artículos de Accesibilidad Digital",
                "item": "https://diegomena.rocks/#blog"
              },
              {
                "@type": "ListItem",
                "position": 3,
                "name": "<%- post.ogTitle.replace(/"/g, '\\"') %>",
                "item": "https://diegomena.rocks/blog/<%= post.slug %>.html"
              }
            ]
          }
        ]
      }
    </script>
  </head>
